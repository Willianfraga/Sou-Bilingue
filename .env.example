# Banco: projeto Supabase próprio, separado do "academia flow" (CLAUDE.md
# decisão 15). Pegue URL e chaves em Project Settings > API do projeto novo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — só usada em src/lib/supabase/admin.ts (webhooks, jobs).
# Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Tutor de IA — obrigatória para a tela /aluno/aula funcionar.
# Pegue a sua em https://console.anthropic.com/settings/keys e cole aqui
# (ou em .env.local, que nunca vai pro git).
ANTHROPIC_API_KEY=

# Fala (STT/TTS) — provedor a decidir
# SPEECH_API_KEY=

# Job de fechamento mensal (/api/jobs/fechamento-mensal) — token que o cron
# (n8n, Vercel Cron) manda no header Authorization: Bearer <token>. Gere um
# valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
