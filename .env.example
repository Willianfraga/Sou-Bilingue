# Banco: projeto Supabase próprio, separado do "academia flow" (CLAUDE.md
# decisão 15). Pegue URL e chaves em Project Settings > API do projeto novo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — só usada em src/lib/supabase/admin.ts (webhooks, jobs).
# Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (links de retorno do pagamento, certificado).
NEXT_PUBLIC_APP_URL=https://app.soubilingue.com.br

# Só para ferramentas locais — nunca no Coolify nem no repositório (público).
# Senha das contas de teste criadas por scripts/seed-usuarios-teste.mjs (16+).
TEST_ACCOUNTS_PASSWORD=
# Token de acesso da conta Supabase (API de gerenciamento: migrations).
SUPABASE_ACCESS_TOKEN=
# Token da API do Coolify (publicação). Apague no painel quando não usar.
COOLIFY_API_TOKEN=

# Tutor de IA — obrigatória para a tela /aluno/aula funcionar.
# Pegue a sua em https://console.anthropic.com/settings/keys e cole aqui
# (ou em .env.local, que nunca vai pro git).
ANTHROPIC_API_KEY=

# Fala (STT/TTS) — ElevenLabs (voz de professores/tutores)
ELEVENLABS_API_KEY=

# Flag de reativação da experiência Tavus na aula em modo video
TAVUS_ENABLED=false

# Job de fechamento mensal (/api/jobs/fechamento-mensal) — token que o cron
# (n8n, Vercel Cron) manda no header Authorization: Bearer <token>. Gere um
# valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Qual modelo Claude usar no chat com o tutor (/api/aula/chat).
# Padrão (sem env var): claude-haiku-4-5-20251001 (barato, bom pra dev).
# Alternativas:
#   - claude-sonnet-5 (qualidade média, preço médio)
#   - claude-opus-5 (melhor qualidade, mais caro — só pra produção)
# O cache só vale para trechos de 4.096+ tokens no Haiku 4.5 — ver
# docs/CUSTOS_IA.md.
ANTHROPIC_MODEL=

# Avatar humano em videochamada (Tavus CVI). A chave fica somente no servidor.
# Crie uma Persona e escolha uma Replica no portal Tavus antes de preencher.
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# Asaas — gateway de pagamento do funil de cadastro (§12 do escopo).
# Em dev, use o ambiente sandbox (https://sandbox.asaas.com/api/v3, chave
# começa com "$aact_hmlg_..."). Em produção, troque pela chave e URL reais
# (https://api.asaas.com/v3, chave "$aact_prod_...") só depois do deploy.
ASAAS_API_KEY=
ASAAS_API_URL=
# Token que o webhook do Asaas deve mandar pra provar que é ele (configure
# o mesmo valor no painel do Asaas, em Integrações > Webhooks). Gere com:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=
